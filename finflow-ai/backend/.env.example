APP_NAME=FinFlow AI
APP_ENV=local
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Use SQLite for fastest local boot, or replace with the Postgres URL below.
DATABASE_URL=sqlite:///./finflow.db
# DATABASE_URL=postgresql+psycopg://finflow:finflow_dev_password@localhost:5432/finflow_ai
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
