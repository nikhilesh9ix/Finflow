# ─── Copy this file to .env — never commit .env ───────────────────────────────

APP_NAME=FinFlow AI

# Application environment: local | staging | production
APP_ENV=local

API_V1_PREFIX=/api/v1

# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — startup fails if this is the default value.
SECRET_KEY=change-me-before-production

# JWT access token lifetime (minutes). Default: 1440 (24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB. Local: the MongoDB Community service on the default port.
# Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=finflow

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── AI (copilot LLM) ─────────────────────────────────────────────────────────
# The copilot picks a provider in this order: Groq → Anthropic → rule-based.
# With neither key set, a deterministic rule-based fallback is used.

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Rate limiting (optional) ─────────────────────────────────────────────────
# Redis URL for distributed rate limiting (multi-instance production).
# When unset, in-memory rate limiting is used (fine for single-instance).
# REDIS_URL=redis://localhost:6379/0
