# ─── Copy this file to .env — never commit .env ───────────────────────────────

APP_NAME=FinFlow AI

# Application environment: local | staging | production
APP_ENV=local

API_V1_PREFIX=/api/v1

# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — startup fails if this is the default value.
SECRET_KEY=change-me-before-production

# JWT access token lifetime (minutes). Default: 1440 (24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for local dev. PostgreSQL for staging/production.
DATABASE_URL=sqlite:///./finflow.db
# DATABASE_URL=postgresql+psycopg://finflow:finflow_dev_password@localhost:5432/finflow_ai

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── AI (Anthropic) ───────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# When set, the copilot uses Claude Haiku with tool calling.
# When unset, a deterministic rule-based fallback is used.
ANTHROPIC_API_KEY=

# ─── Rate limiting (optional) ─────────────────────────────────────────────────
# Redis URL for distributed rate limiting (multi-instance production).
# When unset, in-memory rate limiting is used (fine for single-instance).
# REDIS_URL=redis://localhost:6379/0
