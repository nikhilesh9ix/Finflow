# Root .env — used by docker-compose
# Copy to .env and fill in real values

# Required in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# Anthropic API key — get at https://console.anthropic.com
# When empty, copilot falls back to rule-based answers
ANTHROPIC_API_KEY=

# PostgreSQL password (prod only — used by docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me-postgres-password

# Comma-separated allowed CORS origins for production
BACKEND_CORS_ORIGINS=http://localhost

# JWT lifetime in minutes (default 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
