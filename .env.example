# Root .env — read by docker-compose. Copy to .env and fill in real values.
# .env itself is gitignored; never commit it.

# Required in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# Copilot provider. Groq is used when both are set; with neither, the copilot
# falls back to deterministic rule-based answers.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# MongoDB password (production only — used by docker-compose.prod.yml)
MONGO_PASSWORD=change-me-mongo-password

# Comma-separated allowed CORS origins for production
BACKEND_CORS_ORIGINS=http://localhost

# JWT lifetime in minutes (default 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
